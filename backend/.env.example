# Copy to .env. Every value is overridable per environment (prefix IC_).
IC_ENV=development
IC_DATABASE_URL=postgresql+psycopg://ic:ic@localhost:5432/ic_dev
# Hosted Postgres with a pooler (e.g. Neon): app uses the pooled URL above, migrations this direct one.
IC_MIGRATION_DATABASE_URL=
# Must be replaced (32+ random bytes) in staging and production; the app refuses to start otherwise.
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(48))"
IC_JWT_SECRET=change-me-in-every-environment-0000000000
IC_ACCESS_TOKEN_MINUTES=15
IC_REFRESH_TOKEN_DAYS=30
IC_DEFAULT_LANGUAGE=en
# Private uploads (photos, ID documents, credentials, try-on cut-outs). Local disk only for now.
IC_STORAGE_DIR=./var/uploads
# Photo-analysis models; fill with: python -m app.cli fetch-models
IC_MODEL_DIR=./var/models
# Demo hosting on a free tier that sleeps (e.g. Render): the app's own public health URL.
# The app pings it every IC_KEEP_ALIVE_MINUTES so it stays awake. Leave empty elsewhere.
# On Render, "auto" uses the service's own address (RENDER_EXTERNAL_URL).
IC_KEEP_ALIVE_URL=
IC_KEEP_ALIVE_MINUTES=10
